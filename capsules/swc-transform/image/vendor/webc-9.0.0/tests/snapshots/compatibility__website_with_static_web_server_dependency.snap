---
source: crates/webc/tests/compatibility.rs
expression: pkg.manifest()
---
use:
  wasmer/static-web-server: wasmer/static-web-server@^1
package:
  wapm:
    name: wasmer/docs
    version: 0.15.1
    description: wasmer/docs website
  fs:
    - from: ~
      mount_path: /public
      volume_name: atom
      original_path: /release

