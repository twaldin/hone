# hone-task — single shared seed image for BOTH mutation and evaluation
# sandboxes (build plan §2 contract 1: one image per capsule in the seed).
#
# Contents: debian-slim + python3 (3.11) + node 18 (bookworm ships nodejs 18.x)
# + git. Python deps policy: stdlib + pytest ONLY (apt python3-pytest, no pip).
#
# Build:  docker build -t hone-task -f capsules/Dockerfile.task capsules/
FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    nodejs \
    npm \
    python3 \
    python3-pytest \
  && rm -rf /var/lib/apt/lists/*

# Non-root user for sandbox sessions; workdir matches broker mount convention.
# `sandbox` (uid 2000) exists for evaluator privilege separation: when an eval
# container runs as root, the trusted eval.py setuid-drops the candidate
# worker subprocess to it (see seeded-astar/baseline/eval.py).
RUN useradd --create-home --uid 1000 hone \
  && useradd --no-create-home --uid 2000 --shell /usr/sbin/nologin sandbox
WORKDIR /work
USER hone
