[package]
name = "ascii_table"
version = "4.0.8"
authors = ["Gerrit Viljoen <red.striker@proton.me>"]
license = "MIT"
edition = "2024"

description = "Print ASCII tables to the terminal"
repository = "https://gitlab.com/d5b4b2/ascii-table"
homepage = "https://gitlab.com/d5b4b2/ascii-table"
documentation = "https://docs.rs/ascii_table"
readme = "readme.md"
categories = ["command-line-interface"]
keywords = ["ascii", "table"]

[dependencies]
regex = { version = "1", optional = true }
termize = { version = "0.2", optional = true }
unicode-width = { version = "0.2", optional = true }

[dev-dependencies]
colorful = "0.3"

[features]
auto_table_width = ["dep:termize"]
color_codes = ["dep:regex"]
wide_characters = ["dep:unicode-width"]

[package.metadata.cargo-all-features]
allowlist = ["auto_table_width", "color_codes", "wide_characters"]
