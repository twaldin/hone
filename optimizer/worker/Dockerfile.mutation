# hone-mutation — mutation-sandbox image: hone-task + Bun + the Pi-session
# platform-native addon. The worker itself is NOT baked: its JS (mutate.ts +
# the Pi SDK closure) lives in the digest-sealed optimizer snapshot, is built
# into a self-contained worker.mjs inside this image with no network, and the
# loop putFiles those exact bytes into every mutation sandbox before exec.
#
# Only platform binaries live here (like bun): the pinned Pi SDK's native
# addon is baked next to bun, where the SDK loader's exec-dir candidate finds
# it — a .node binary cannot ride inside a JS bundle. The addon version MUST
# match the @oh-my-pi/pi-coding-agent version pinned in optimizer/package.json
# (the loader enforces the version sentinel and fails closed on drift).
#
# Build:  docker build -t hone-mutation:latest -f optimizer/worker/Dockerfile.mutation optimizer/worker
# Smoke:  docker run --rm hone-mutation:latest bun --version
FROM hone-task:latest

USER root

# Bun, pinned. Release asset arch names: amd64 -> x64, arm64 -> aarch64.
ARG BUN_VERSION=1.3.14
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl unzip \
  && arch="$(dpkg --print-architecture)" \
  && case "$arch" in arm64) bunArch=aarch64 ;; amd64) bunArch=x64 ;; *) echo "unsupported arch: $arch" >&2; exit 1 ;; esac \
  && curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${bunArch}.zip" \
  && unzip -q /tmp/bun.zip -d /tmp \
  && mv "/tmp/bun-linux-${bunArch}/bun" /usr/local/bin/bun \
  && chmod 755 /usr/local/bin/bun \
  && rm -rf /tmp/bun.zip "/tmp/bun-linux-${bunArch}" \
  && apt-get purge -y curl unzip \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

# Pi native addon, pinned to the SDK version sealed in the optimizer snapshot.
# npm pack (not install): one tarball, no node_modules ever lands in the image.
ARG PI_VERSION=16.5.2
RUN arch="$(dpkg --print-architecture)" \
  && case "$arch" in arm64) piArch=arm64 ;; amd64) piArch=x64 ;; *) echo "unsupported arch: $arch" >&2; exit 1 ;; esac \
  && mkdir /tmp/pi-natives \
  && cd /tmp/pi-natives \
  && npm pack "@oh-my-pi/pi-natives-linux-${piArch}@${PI_VERSION}" --silent \
  && tar -xzf oh-my-pi-pi-natives-linux-*.tgz \
  && install -m 644 package/pi_natives.linux-*.node /usr/local/bin/ \
  && cd / \
  && rm -rf /tmp/pi-natives /root/.npm /root/.cache

USER hone
WORKDIR /work
